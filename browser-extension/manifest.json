{
  "manifest_version": 3,
  "name": "WorkPulse Domain Bridge",
  "version": "1.0.0",
  "description": "Opt-in sharing of the active website's domain with WorkPulse. No URL paths, browsing history or page data.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WorkPulse pairing",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
