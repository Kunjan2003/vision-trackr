{
  "name": "workpulse-desktop",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:ui": "tsc --noEmit && vite build",
    "build:win": "npm run build:ui && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.workpulse.desktop",
    "productName": "WorkPulse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/workpulse-backend.exe",
        "to": "bin/workpulse-backend.exe"
      },
      {
        "from": "../browser-extension",
        "to": "browser-extension"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "WorkPulse-Setup.exe",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kunjan2003",
        "repo": "vision-trackr"
      }
    ]
  }
}
